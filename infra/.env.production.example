# Copy to a file outside source control and pass it with docker compose --env-file.
KRYPTON_DOMAIN=remote.example.com
PUBLIC_IP=203.0.113.10
# Generate separate random hex secrets. No development defaults are accepted.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
DEVICE_ENROLLMENT_SIGNING_KEY=
TURN_SECRET=
# Optional additional HTTPS frontend origins, comma-separated.
CORS_ORIGINS=
