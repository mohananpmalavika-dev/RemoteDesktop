FROM node:22-alpine AS builder
WORKDIR /app
RUN apk add --no-cache python3 make g++ openssl
COPY package*.json ./
COPY packages/ ./packages/
COPY services/ ./services/
COPY apps/admin-web/ ./apps/admin-web/
COPY apps/desktop/package.json ./apps/desktop/package.json
COPY prisma/ ./prisma/
COPY tsconfig.base.json ./
RUN npm ci
RUN npx prisma generate --schema=prisma/schema.prisma
RUN npm run build --workspace=@krypton/shared-types && npm run build --workspace=@krypton/config && npm run build --workspace=@krypton/logger && npm run build --workspace=@krypton/protocol
RUN npm run build --workspace=@krypton/api && npm run build --workspace=@krypton/admin-web

FROM builder AS migrations
CMD ["npx", "prisma", "migrate", "deploy", "--schema=prisma/schema.prisma"]

FROM builder AS dependencies
RUN npm prune --omit=dev --ignore-scripts

FROM node:22-alpine AS runner
WORKDIR /app
RUN apk add --no-cache openssl
COPY --from=dependencies --chown=node:node /app/node_modules ./node_modules
COPY --from=dependencies --chown=node:node /app/packages ./packages
COPY --from=builder --chown=node:node /app/services/api ./services/api
COPY --from=builder --chown=node:node /app/apps/admin-web/dist ./public
COPY --from=builder --chown=node:node /app/prisma ./prisma
USER node
ENV NODE_ENV=production
EXPOSE 4000
CMD ["node", "services/api/dist/main.js"]
