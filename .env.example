# ==============================================================================
# KryptonRemote - Environment Configuration Template
# DO NOT store real production secrets in this file.
# In production, services FAIL FAST if required variables are missing or point to localhost.
# ==============================================================================

# Environment mode: 'development' | 'test' | 'production'
NODE_ENV=development

# Application Identification & Branding
APP_NAME=KryptonRemote
COMPANY_NAME=KryptonLogic
SUPPORT_URL=https://support.kryptonlogic.com

# Service Ports & Host Binding
API_PORT=4000
API_HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:4000

SIGNALING_PORT=4001
SIGNALING_HOST=0.0.0.0
SIGNALING_PUBLIC_URL=ws://localhost:4001/signaling

ADMIN_PORT=3000

# Persistence: PostgreSQL 16
DATABASE_URL=postgresql://krypton:krypton_secret_dev@localhost:5432/krypton_remote?schema=public

# Distributed Cache & State: Redis 7
REDIS_URL=redis://localhost:6379

# Authentication & JWT Secrets (Base64-encoded or PEM in production)
JWT_ACCESS_SECRET=dev_jwt_access_secret_do_not_use_in_production_min_32_chars!
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_do_not_use_in_production_min_32_chars!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Device Enrollment Secret
DEVICE_ENROLLMENT_SIGNING_KEY=dev_enrollment_signing_key_min_32_chars!

# STUN & TURN Infrastructure (coturn)
# In production, TURN credentials are short-lived, generated using a shared secret.
STUN_URLS=stun:localhost:3478
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
TURN_SECRET=dev_turn_shared_secret_min_16_chars
TURN_REALM=kryptonremote.net
TURN_CREDENTIAL_TTL_SECONDS=86400

# Telemetry & Observability
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Rate Limiting (Redis-backed in production)
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_TTL_SECONDS=60
RATE_LIMIT_SESSION_CREATE_MAX=10
RATE_LIMIT_SESSION_CREATE_TTL_SECONDS=60
