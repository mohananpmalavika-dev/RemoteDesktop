{
  "name": "krypton-remote-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "KryptonRemote - Enterprise Production-Grade Remote Desktop Platform",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:native": "cargo test --package device-identity --package krypton-input --package krypton-file-transfer --package krypton-remote-core --package krypton-transport",
    "test:all": "npm run test && npm run test:native",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "docker:up": "docker compose -f infra/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker-compose.yml down",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=prisma/schema.prisma"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "dotenv": "^16.4.7",
    "prisma": "^6.3.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "zod": "^3.24.1"
  }
}
